# Copy this file to .env and fill in the required values.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Embeddings (local = free and runs on CPU) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_TOKENS=512
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODEL=openai/gpt-4o-mini
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_MODEL=deepseek-flash
# For local generation with llama.cpp (no API key required):
# LLM_PROVIDER=llama_cpp
# LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
# LLAMA_CPP_MODEL=local-model

# --- Chunking / retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# --- Vector store ---
VECTOR_STORE_PATH=./storage/chroma
# Set CHROMA_HOST to use a separate Chroma server instead of embedded storage.
# CHROMA_HOST=localhost
CHROMA_PORT=8000
COLLECTION_NAME=documents
# DEMO_CORPUS_PATH=./data/documents

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# API_KEY=change-me   # uncomment to protect the API in production
PUBLIC_DEMO_QUERY=false
ADMIN_API_ENABLED=false
MAX_UPLOAD_BYTES=5000000
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
