# Alternative à Docker: lancer directement avec uvicorn via systemd.
# A copier dans /etc/systemd/system/rag-system.service puis:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rag-system

[Unit]
Description=RAG System API
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/rag-system
EnvironmentFile=/opt/rag-system/.env
ExecStart=/opt/rag-system/.venv/bin/uvicorn src.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
